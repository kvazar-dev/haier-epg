<?xml version="1.0" encoding="utf-8"?>
<!-- 320x180 banner for the Leanback launcher tile: dark field, a guide grid glyph and the name. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="320dp" android:height="180dp" />
            <gradient android:angle="45" android:startColor="#FF101827" android:endColor="#FF1F3A6B" />
        </shape>
    </item>
    <item android:left="36dp" android:top="40dp" android:right="36dp" android:bottom="78dp">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="#333D8BFF" />
        </shape>
    </item>
    <item android:left="36dp" android:top="40dp" android:right="200dp" android:bottom="78dp">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="#FF3D8BFF" />
        </shape>
    </item>
    <item android:left="36dp" android:top="112dp" android:right="120dp" android:bottom="56dp">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="#99FFFFFF" />
        </shape>
    </item>
    <item android:left="36dp" android:top="128dp" android:right="180dp" android:bottom="40dp">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="#66FFFFFF" />
        </shape>
    </item>
</layer-list>
